# PostgreSQL (Docker default below matches docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/traveloop"

# API
API_PORT=4000
JWT_SECRET="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:3000"

# Web (browser → Express API)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Optional: server-side fetch from Next container to API (Docker Compose sets this)
# INTERNAL_API_URL="http://api:4000"
